# StudySpark AI (Expo app) environment template.
# Copy to .env.local for local development:  copy .env.example .env.local
# .env.local is git-ignored. Restart Expo (npx expo start -c) after changing it.
#
# IMPORTANT: every variable prefixed with EXPO_PUBLIC_ is bundled into the app and
# readable by anyone who installs it. Never put AI provider keys, database passwords
# or other secrets here. The AI key lives only on the API server:
# apps/api/.env.local (see apps/api/.env.example).

# Which environment the app is running in: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Base URL of the StudySpark API (apps/api, `npm run api:dev`, port 3001).
# - Web preview on this PC: http://localhost:3001
# - Phone with Expo Go: this PC's Wi-Fi address, e.g. http://192.168.1.3:3001
#   (find it with `ipconfig`; the phone must be on the same network).
EXPO_PUBLIC_API_BASE_URL=
