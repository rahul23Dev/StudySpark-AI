# StudySpark AI environment template.
# Copy to .env.local for local development:  copy .env.example .env.local
# .env.local is git-ignored. Never commit real values.
#
# IMPORTANT: every variable prefixed with EXPO_PUBLIC_ is bundled into the app
# and readable by anyone who installs it. Never put AI provider keys, database
# passwords or other secrets in an EXPO_PUBLIC_ variable. AI calls will go through
# a backend you control (planned for a later phase), which holds the secret keys.

# Which environment the app is running in: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Base URL of the StudySpark AI backend (not built yet - leave empty).
EXPO_PUBLIC_API_BASE_URL=
