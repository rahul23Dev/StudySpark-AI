# StudySpark AI API (apps/api) environment template.
# For local development copy this to .env.local (git-ignored) and fill in the key:
#   copy .env.example .env.local
# Never commit real keys. The key stays on this server; the mobile app never sees it.

# Anthropic API key, from https://platform.claude.com/ > API keys. Leave empty to run
# without AI: generation endpoints then answer 503 "ai_not_configured".
ANTHROPIC_API_KEY=

# Model ID (see https://platform.claude.com/docs/en/about-claude/models/overview).
AI_MODEL=claude-opus-5-5
# Effort: low | medium | high (Claude Opus 5.5 defaults to medium).
AI_EFFORT=medium

# Per-attempt timeout in milliseconds, SDK retries for 429/5xx/network errors (0-3),
# and how many times to re-ask the model when its output fails validation (1-3).
AI_TIMEOUT_MS=60000
AI_MAX_SDK_RETRIES=2
AI_MAX_VALIDATION_ATTEMPTS=2

# Usage bounds (in-memory, per server process).
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=60000
AI_MAX_CONCURRENT=3
# Input + output tokens allowed per UTC day across all users. At Claude Opus 5.5 prices
# ($4 / $20 per million) 500,000 tokens costs at most about $10.
AI_DAILY_TOKEN_BUDGET=500000
# Largest accepted request body in bytes.
AI_MAX_BODY_BYTES=65536

# Browser origins allowed to call the API (comma separated). Native apps don't need this.
ALLOWED_ORIGINS=http://localhost:8081,http://192.168.1.3:8081
